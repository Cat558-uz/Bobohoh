local UserTab = Window:Tab({Title = "User", Icon = "user"})

-- script create BY ghost

local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local Camera = workspace.CurrentCamera

local TargetPlayer = nil
local ViewEnabled = false

-- Buscar jogador (por nome parcial, minúsculo)
local function findPlayerByName(name)
	name = name:lower()
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr.Name:lower():sub(1, #name) == name then
			return plr
		end
	end
	return nil
end

-- Gerar prefixo do alvo (3 letras minúsculas)
local function getTargetPrefix()
	if TargetPlayer then
		return string.sub(TargetPlayer.Name:lower(), 1, 3)
	else
		return nil
	end
end

-- INPUT BOX para definir o alvo
UserTab:Input({
	Title = "Selecionar Jogador",
	Placeholder = "Digite o nome ou início do nome...",
	Callback = function(text)
		local found = findPlayerByName(text)
		if found then
			TargetPlayer = found
			WindUI:Notify({
				Title = "Jogador Selecionado",
				Content = "Alvo definido: " .. TargetPlayer.Name,
				Duration = 3,
				Icon = "user-check"
			})
		else
			WindUI:Notify({
				Title = "Não encontrado",
				Content = "Nenhum jogador com esse nome.",
				Duration = 3,
				Icon = "x-circle"
			})
		end
	end
})

-- TOGGLE: View Alvo
UserTab:Toggle({
	Title = "View Alvo",
	Desc = "Ativa visão no jogador selecionado",
	Icon = "eye",
	Type = "Checkbox",
	Value = false,
	Callback = function(state)
		ViewEnabled = state
		if state then
			if TargetPlayer and TargetPlayer.Character and TargetPlayer.Character:FindFirstChildWhichIsA("Humanoid") then
				Camera.CameraSubject = TargetPlayer.Character:FindFirstChildWhichIsA("Humanoid")
			else
				WindUI:Notify({
					Title = "Erro",
					Content = "Nenhum alvo válido selecionado.",
					Duration = 3,
					Icon = "alert-triangle"
				})
			end
		else
			Camera.CameraSubject = LocalPlayer.Character:FindFirstChildWhichIsA("Humanoid")
		end
	end
})

-- BOTÃO: Teleporte (move o player para frente do alvo)
UserTab:Button({
	Title = "Teleporte",
	Callback = function()
		if TargetPlayer 
		and TargetPlayer.Character 
		and TargetPlayer.Character:FindFirstChild("HumanoidRootPart") 
		and LocalPlayer.Character 
		and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then

			local targetRoot = TargetPlayer.Character.HumanoidRootPart
			local localRoot = LocalPlayer.Character.HumanoidRootPart

			-- Calcula posição 3 studs à frente do alvo
			local newPos = targetRoot.Position + targetRoot.CFrame.LookVector * 3
			localRoot.CFrame = CFrame.new(newPos, targetRoot.Position)

			WindUI:Notify({
				Title = "Teleporte",
				Content = "Você foi para frente de " .. TargetPlayer.Name,
				Duration = 3,
				Icon = "navigation"
			})
		else
			WindUI:Notify({
				Title = "Erro",
				Content = "Nenhum alvo válido selecionado.",
				Duration = 3,
				Icon = "alert-triangle"
			})
		end
	end
})




-- script create BY ghost

local Players = game:GetService("Players")
local TextChatService = game:GetService("TextChatService")

-- Envia mensagem no chat
local function sendChatMessage(message)
	if TextChatService.ChatInputBarConfiguration
	and TextChatService.ChatInputBarConfiguration.TargetTextChannel then
		local canal = TextChatService.ChatInputBarConfiguration.TargetTextChannel
		canal:SendAsync(message)
	end
end

-- Mostra notificação somente se detectar algo
local function showFound(plr)
	WindUI:Notify({
		Title = "Found",
		Content = "User identificado: " .. plr.Name,
		Duration = 5,
		Icon = "alert-triangle"
	})
end

-- Verifica mensagens no chat
local function checkMessage(plr, msg)
	local lowerMsg = msg:lower()
	if lowerMsg:find("havens_") or lowerMsg:find("domer_") then
		showFound(plr)
	end
end

-- Botão principal
UserTab:Button({
	Title = "Verificar Usuários",
	Callback = function()
		sendChatMessage(";v")

		-- Jogadores atuais
		for _, plr in ipairs(Players:GetPlayers()) do
			local name = plr.Name:lower()
			if name:find("havens_") or name:find("domer_") then
				showFound(plr)
			end
			plr.Chatted:Connect(function(msg)
				checkMessage(plr, msg)
			end)
		end

		-- Jogadores novos
		Players.PlayerAdded:Connect(function(plr)
			local name = plr.Name:lower()
			if name:find("havens_") or name:find("domer_") then
				showFound(plr)
			end
			plr.Chatted:Connect(function(msg)
				checkMessage(plr, msg)
			end)
		end)
	end
})

