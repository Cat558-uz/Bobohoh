--== ATUALIZAÇÃO DE PLAYERS ==--
local selected = nil
local memory = {}

local function updateList()
	for _, v in ipairs(PlayerList:GetChildren()) do
		if v:IsA("TextButton") then v:Destroy() end
	end
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= LocalPlayer then
			local short = string.sub(plr.Name, 1, 3)
			memory[plr.Name] = short
			local btn = Instance.new("TextButton", PlayerList)
			btn.Size = UDim2.new(1, -4, 0, 26)
			btn.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
			btn.TextColor3 = Color3.new(1, 1, 1)
			btn.Font = Enum.Font.SourceSans
			btn.TextSize = 15
			btn.Text = plr.Name .. " (" .. short .. ")"
			Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 4)
			btn.MouseButton1Click:Connect(function()
				selected = plr
				SelectedLabel.Text = "Alvo: " .. plr.Name
				TweenService:Create(btn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(80,80,80)}):Play()
			end)
		end
	end
end
updateList()
Players.PlayerAdded:Connect(updateList)
Players.PlayerRemoving:Connect(updateList)

--== EXECUTAR COMANDO ==--
local function executeCommand(cmd)
	if not selected and cmd ~= ";say" then return end
	local name = selected and (memory[selected.Name] or selected.Name) or ""
	local reason = ReasonBox.Text
	if cmd == ";kick" or cmd == ";say" then
		if reason ~= "" then
			sendChat(cmd .. " " .. name .. " " .. reason)
		else
			sendChat(cmd .. " " .. name)
		end
	else
		sendChat(cmd .. " " .. name)
	end
end

--== CRIA BOTÕES ==--
local function makeCmdButton(text, cmd)
	local b = Instance.new("TextButton", CmdFrame)
	b.Size = UDim2.new(1, -8, 0, 28)
	b.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
	b.TextColor3 = Color3.new(1, 1, 1)
	b.Text = text
	b.Font = Enum.Font.SourceSansBold
	b.TextSize = 16
	Instance.new("UICorner", b).CornerRadius = UDim.new(0, 6)
	b.MouseButton1Click:Connect(function()
		TweenService:Create(b, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(100, 0, 0)}):Play()
		executeCommand(cmd)
		task.wait(0.3)
		TweenService:Create(b, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(50, 50, 50)}):Play()
	end)
end

makeCmdButton("Kill", ";kill")
makeCmdButton("Kick", ";kick")
makeCmdButton("Bring", ";bring")
