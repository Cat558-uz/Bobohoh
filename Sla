local function Tween(obj,time,data)
    TweenService:Create(
        obj,
        TweenInfo.new(time,Enum.EasingStyle.Quad,Enum.EasingDirection.Out),
        data
    ):Play()
end

local function Dragify(frame,hold)
    local drag,dragInput,start,startPos

    local function Update(input)
        local delta = input.Position - start

        frame.Position = UDim2.new(
            startPos.X.Scale,startPos.X.Offset + delta.X,
            startPos.Y.Scale,startPos.Y.Offset + delta.Y
        )
    end

    hold.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 then
            drag = true
            start = i.Position
            startPos = frame.Position

            i.Changed:Connect(function()
                if i.UserInputState == Enum.UserInputState.End then
                    drag = false
                end
            end)
        end
    end)

    hold.InputChanged:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseMovement then
            dragInput = i
        end
    end)

    UIS.InputChanged:Connect(function(i)
        if drag and i == dragInput then
            Update(i)
        end
    end)
end

