end

local function findPlayer(txt)
	txt = string.lower(txt)

	for _,plr in ipairs(Players:GetPlayers()) do
		if string.find(string.lower(plr.Name),txt,1,true)
		or string.find(string.lower(plr.DisplayName),txt,1,true) then
			return plr
		end
	end
end

local function sendChat(msg)
	local enviado = false

	pcall(function()
		local cfg = TextChatService.ChatInputBarConfiguration

		if cfg and cfg.TargetTextChannel then
			cfg.TargetTextChannel:SendAsync(msg)
			enviado = true
		end
	end)

	if enviado then
		return
	end

	pcall(function()
		local channels = TextChatService:FindFirstChild("TextChannels")

		if channels then
			local general = channels:FindFirstChild("RBXGeneral")

			if general then
				general:SendAsync(msg)
			end
		end
	end)
end

local function getShortName()
	if alvo == "" then
		return
	end

	local plr = findPlayer(alvo)

	if not plr then
		return
	end

	return string.sub(plr.Name,1,4)
end

local function runCmd(cmd,useReason)
	local short = getShortName()

	if not short then
		notify("Painel","Alvo não encontrado",2)
		return
	end

	local msg = cmd.." "..short

	if useReason and razao ~= "" then
		msg = msg.." "..razao
	end

	sendChat(msg)
	notify("Painel","Comando enviado",1)
end

local function runSelf(cmd)
	sendChat(cmd)
	notify("Painel","Comando enviado",1)
end

