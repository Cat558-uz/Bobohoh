end

function Tab:CreateSlider(text,min,max,default,callback)
    order += 1

    min = min or 0
    max = max or 100
    local value = default or min
    local dragging = false

    local holder = Instance.new("Frame")
    holder.LayoutOrder = order
    holder.Size = UDim2.new(1,0,0,54)
    holder.BackgroundColor3 = Color3.fromRGB(255,255,255)
    holder.BackgroundTransparency = .93
    holder.Parent = page
    Instance.new("UICorner",holder).CornerRadius = UDim.new(0,10)

    local title = Instance.new("TextLabel")
    title.Size = UDim2.new(1,-50,0,18)
    title.Position = UDim2.new(0,8,0,6)
    title.BackgroundTransparency = 1
    title.Text = text or "Slider"
    title.TextColor3 = Color3.new(1,1,1)
    title.Font = Enum.Font.GothamMedium
    title.TextSize = 13
    title.TextXAlignment = Enum.TextXAlignment.Left
    title.Parent = holder

    local number = Instance.new("TextLabel")
    number.Size = UDim2.new(0,50,0,18)
    number.Position = UDim2.new(1,-55,0,6)
    number.BackgroundTransparency = 1
    number.TextColor3 = Color3.fromRGB(220,220,220)
    number.Font = Enum.Font.Gotham
    number.TextSize = 12
    number.Text = tostring(value)
    number.Parent = holder

    local bar = Instance.new("Frame")
    bar.Size = UDim2.new(1,-12,0,8)
    bar.Position = UDim2.new(0,6,0,34)
    bar.BackgroundColor3 = Color3.fromRGB(30,30,30)
    bar.Parent = holder
    Instance.new("UICorner",bar).CornerRadius = UDim.new(1,0)

    local fill = Instance.new("Frame")
    fill.Size = UDim2.new(0,0,1,0)
    fill.BackgroundColor3 = Color3.new(1,1,1)
    fill.Parent = bar
    Instance.new("UICorner",fill).CornerRadius = UDim.new(1,0)

    local function set(v)
        v = math.clamp(v,min,max)
        value = math.floor(v)

        local percent = (value - min) / (max - min)
        fill.Size = UDim2.new(percent,0,1,0)
        number.Text = tostring(value)

        if callback then
            callback(value)
        end
    end

    set(value)

    bar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
        end
    end)

    bar.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)

    UIS.InputChanged:Connect(function(input)
        if not dragging then return end

        if input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch then

            local pos = input.Position.X - bar.AbsolutePosition.X
            local percent = math.clamp(pos / bar.AbsoluteSize.X,0,1)

            set(min + (max - min) * percent)
        end
    end)

    local Slider = {}

    function Slider:Set(v)
        set(v)
    end

    function Slider:Get()
        return value
    end

    return Slider
end

