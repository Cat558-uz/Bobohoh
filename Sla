local texturesCache = {}
local shadowCache = {}
local isRunning = false

local TARGET_CLASSES = {
    ["Decal"] = true,
    ["Texture"] = true
}

local function applyAntiLag()
    if isRunning then return end
    isRunning = true

    local descendants = workspace:GetDescendants()
    
    for i = 1, #descendants do
        if not isRunning then break end
        
        local obj = descendants[i]
        
        if TARGET_CLASSES[obj.ClassName] then
            texturesCache[obj] = obj.Parent
            obj.Parent = nil
        elseif obj:IsA("BasePart") and obj.CastShadow then
            shadowCache[obj] = true
            obj.CastShadow = false
        end

        if i % 100 == 0 then
            task.wait()
        end
    end
end

local function restoreSettings()
    isRunning = false

    for obj, parent in pairs(texturesCache) do
        if obj and parent then
            obj.Parent = parent
        end
    end

    for obj, _ in pairs(shadowCache) do
        if obj then
            obj.CastShadow = true
        end
    end

    table.clear(texturesCache)
    table.clear(shadowCache)
end

c2Tab:Toggle("Anti Lag ( New )", nil, function(v)
    if v then
        task.spawn(applyAntiLag)
    else
        restoreSettings()
    end
end)


