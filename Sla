local function ApplyConfig()
	savedWidth = config.Width
	savedHeight = config.Height

	user.Size = UDim2.new(
		0,
		config.Width,
		0,
		config.Height
	)

	user.BackgroundTransparency = config.Transparency

	for _,obj in pairs(gui:GetDescendants()) do
		if obj:IsA("UICorner") then
			obj.CornerRadius = UDim.new(0,config.Corner)
		end
	end
end

local function SaveConfig()
	if not writefile then
		return
	end

	writefile(
		configFile,
		HttpService:JSONEncode(config)
	)

	Window:Notify(
		"Config",
		"Configuração salva"
	)
end

local function LoadConfig()
	if not readfile or not isfile then
		return
	end

	if not isfile(configFile) then
		return
	end

	local success,data = pcall(function()
		return HttpService:JSONDecode(
			readfile(configFile)
		)
	end)

	if success and data then
		config.Width = data.Width or 430
		config.Height = data.Height or 270
		config.Corner = data.Corner or 14
		config.Transparency = data.Transparency or 0.08

		ApplyConfig()
	end
end

local function ResetConfig()
	config = {
		Width = 430,
		Height = 270,
		Corner = 14,
		Transparency = 0.08
	}

	ApplyConfig()

	if delfile and isfile and isfile(configFile) then
		delfile(configFile)
	end

	Window:Notify(
		"Config",
		"Configuração resetada"
	)
end

