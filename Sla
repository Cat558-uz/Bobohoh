-- Notification System (Executor Ready, Clean & Optimized)

local TweenService = game:GetService("TweenService")
local CoreGui = game:GetService("CoreGui")

local Notification = {}
Notification.__index = Notification

local CONFIG = {
    MaxNotifications = 5,
    Padding = 10,
    Width = 300,
    Position = "BottomRight", -- BottomRight / TopRight
    DefaultDuration = 5
}

local COLORS = {
    Background = Color3.fromRGB(30,30,30),
    Success = Color3.fromRGB(80,200,120),
    Error = Color3.fromRGB(220,70,70),
    Warning = Color3.fromRGB(240,180,60),
    Info = Color3.fromRGB(80,140,255)
}

local ICONS = {
    Success = "rbxassetid://12690727184",
    Error = "rbxassetid://103344771690872",
    Warning = "rbxassetid://15484984201",
    Info = "rbxassetid://76311199408449"
}

local gui = Instance.new("ScreenGui")
gui.Name = "NotifySystem"
gui.ResetOnSpawn = false
pcall(function() gui.Parent = CoreGui end)

local container = Instance.new("Frame")
container.BackgroundTransparency = 1
container.Size = UDim2.new(1,0,1,0)
container.Parent = gui

local list = Instance.new("UIListLayout")
list.Padding = UDim.new(0, CONFIG.Padding)
list.SortOrder = Enum.SortOrder.LayoutOrder
list.VerticalAlignment = CONFIG.Position == "BottomRight" and Enum.VerticalAlignment.Bottom or Enum.VerticalAlignment.Top
list.HorizontalAlignment = Enum.HorizontalAlignment.Right
list.Parent = container

local active = {}
local queue = {}

local function createNotification(data)
    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(0, CONFIG.Width, 0, 70)
    frame.BackgroundColor3 = COLORS.Background
    frame.BackgroundTransparency = 0.1
    frame.AnchorPoint = Vector2.new(1, CONFIG.Position == "BottomRight" and 1 or 0)
    frame.ClipsDescendants = true

    local corner = Instance.new("UICorner", frame)
    corner.CornerRadius = UDim.new(0, 10)

    local stroke = Instance.new("UIStroke", frame)
    stroke.Color = COLORS[data.Type] or COLORS.Info
    stroke.Thickness = 1

    local icon = Instance.new("ImageLabel")
    icon.Size = UDim2.new(0,24,0,24)
    icon.Position = UDim2.new(0,10,0,10)
    icon.BackgroundTransparency = 1
    icon.Image = ICONS[data.Type] or ICONS.Info
    icon.Parent = frame

    local title = Instance.new("TextLabel")
    title.Text = data.Title or "Notification"
    title.Font = Enum.Font.GothamBold
    title.TextSize = 14
    title.TextColor3 = Color3.new(1,1,1)
    title.BackgroundTransparency = 1
    title.Position = UDim2.new(0,40,0,8)
    title.Size = UDim2.new(1,-50,0,18)
    title.TextXAlignment = Enum.TextXAlignment.Left
    title.Parent = frame

    local text = Instance.new("TextLabel")
    text.Text = data.Text or ""
    text.Font = Enum.Font.Gotham
    text.TextSize = 13
    text.TextColor3 = Color3.fromRGB(200,200,200)
    text.BackgroundTransparency = 1
    text.Position = UDim2.new(0,40,0,26)
    text.Size = UDim2.new(1,-50,0,30)
    text.TextWrapped = true
    text.TextXAlignment = Enum.TextXAlignment.Left
    text.Parent = frame

    local progress = Instance.new("Frame")
    progress.BackgroundColor3 = COLORS[data.Type] or COLORS.Info
    progress.Size = UDim2.new(1,0,0,3)
    progress.Position = UDim2.new(0,0,1,-3)
    progress.BorderSizePixel = 0
    progress.Parent = frame

    local close = Instance.new("TextButton")
    close.Text = "X"
    close.Font = Enum.Font.GothamBold
    close.TextSize = 12
    close.TextColor3 = Color3.fromRGB(180,180,180)
    close.BackgroundTransparency = 1
    close.Size = UDim2.new(0,20,0,20)
    close.Position = UDim2.new(1,-25,0,5)
    close.Parent = frame

    frame.Parent = container

    frame.Position = UDim2.new(1, 350, 1, 0)
    frame.BackgroundTransparency = 1

    TweenService:Create(frame, TweenInfo.new(0.3, Enum.EasingStyle.Quad), {
        Position = UDim2.new(1, -10, 1, 0),
        BackgroundTransparency = 0.1
    }):Play()

    local duration = data.Duration or CONFIG.DefaultDuration

    TweenService:Create(progress, TweenInfo.new(duration, Enum.EasingStyle.Linear), {
        Size = UDim2.new(0,0,0,3)
    }):Play()

    local removed = false

    local function remove()
        if removed then return end
        removed = true

        TweenService:Create(frame, TweenInfo.new(0.25, Enum.EasingStyle.Quad), {
            Position = UDim2.new(1, 350, 1, 0),
            BackgroundTransparency = 1
        }):Play()

        task.delay(0.3, function()
            frame:Destroy()
            table.remove(active, table.find(active, frame))
            if #queue > 0 then
                local nextData = table.remove(queue, 1)
                Notification:Notify(nextData)
            end
        end)
    end

    close.MouseButton1Click:Connect(remove)
    task.delay(duration, remove)

    table.insert(active, frame)
end

function Notification:Notify(data)
    data.Type = data.Type or "Info"

    if #active >= CONFIG.MaxNotifications then
        table.insert(queue, data)
        return
    end

    createNotification(data)
end

-- GLOBAL FUNCTION
getgenv().Notify = function(tbl)
    Notification:Notify(tbl)
end


