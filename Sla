    local function RefreshSize()
        local count = #options

        if opened then
            holder.Size = UDim2.new(1,0,0,52 + count * 26)
            listHolder.Size = UDim2.new(1,-12,0,count * 26)
        else
            holder.Size = UDim2.new(1,0,0,52)
            listHolder.Size = UDim2.new(1,-12,0,0)
        end
    end

    local function CreateOption(value)
        local option = Instance.new("TextButton")
        option.Size = UDim2.new(1,0,0,26)
        option.BackgroundTransparency = 1
        option.Text = tostring(value)
        option.TextColor3 = Color3.fromRGB(220,220,220)
        option.Font = Enum.Font.Gotham
        option.TextSize = 12
        option.Parent = listHolder

        option.MouseButton1Click:Connect(function()
            selected = value
            label.Text = tostring(value)
            opened = false
            arrow.Text = "v"
            Tween(holder,.15,{Size = UDim2.new(1,0,0,52)})

            if callback then
                callback(value)
            end
        end)

        table.insert(options,{Name = value, Button = option})
        RefreshSize()
    end

    for _,v in pairs(list or {}) do
        CreateOption(v)
    end

    user.MouseButton1Click:Connect(function()
        opened = not opened

        if opened then
            arrow.Text = "^"
        else
            arrow.Text = "v"
        end

        RefreshSize()
    end)

    local Dropdown = {}

    function Dropdown:Set(value)
        selected = value
        label.Text = tostring(value)

        if callback then
            callback(value)
        end
    end

    function Dropdown:Get()
        return selected
    end

    function Dropdown:Add(value)
        CreateOption(value)
    end

    function Dropdown:Remove(value)
        for i,v in pairs(options) do
            if v.Name == value then
                v.Button:Destroy()
                table.remove(options,i)
                break
            end
        end

        RefreshSize()
    end

    function Dropdown:Clear()
        for _,v in pairs(options) do
            v.Button:Destroy()
        end

        options = {}
        selected = nil
        label.Text = "Selecionar"
        RefreshSize()
    end

